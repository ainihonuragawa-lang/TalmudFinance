---
import "../styles/global.css";

interface Props {
  title?: string;
  currentTab?: "today" | "market" | "teachings";
}

const { title = "賢者の金融市場", currentTab = "today" } = Astro.props;

// ローカル: "/" / GitHub Pages: "/TalmudFinance/"
const rawBase = import.meta.env.BASE_URL || "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#22201C" />
    <meta name="description" content="古代ユダヤの知恵と現代の市場データを、毎日1つの教えと主要市場指標で読み解く。" />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <nav class="tab-nav">
      <a href={base} class={currentTab === "today" ? "active" : ""}>今日</a>
      <a href={`${base}market/`} class={currentTab === "market" ? "active" : ""}>マーケット</a>
      <a href={`${base}teachings/`} class={currentTab === "teachings" ? "active" : ""}>教え一覧</a>
    </nav>
  </body>
</html>
