---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  currentTab?: "today" | "market" | "guides" | "teachings";
}

const {
  title = "賢者の金融市場",
  description =
    "古代ユダヤ・タルムードの知恵と、日本株・米国株・為替・金利などの市場データを毎日1画面で。落ち着いて相場を学ぶための学習サイトです。",
  currentTab,
} = Astro.props;

// ローカル: "/" / GitHub Pages: "/TalmudFinance/"
const rawBase = import.meta.env.BASE_URL || "/";
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;

// 自己参照 canonical（実際の配信URLに一致させる）
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;

// サイトのルートURL（本番: https://talmudfinance.com/）
const siteRoot = (Astro.site ?? new URL("https://talmudfinance.com/")).href;

// 全ページ共通の構造化データ（WebSite + Organization）
const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "賢者の金融市場",
  url: siteRoot,
  description:
    "古代ユダヤ・タルムードの知恵と、日本株・米国株・為替・金利などの市場データを毎日1画面で。落ち着いて相場を学ぶための学習サイトです。",
  inLanguage: "ja",
  publisher: { "@type": "Organization", name: "賢者の金融市場" },
};

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "賢者の金融市場",
  url: siteRoot,
  founder: { "@type": "Person", name: "AI日本の裏側" },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#22201C" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="賢者の金融市場" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5692505287904140" crossorigin="anonymous"></script>
  </head>
  <body>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-brand">賢者の金融市場</div>
      <nav aria-label="サイト情報">
        <a href={`${base}about/`}>このサイトについて</a>
        <a href={`${base}guides/`}>市場の読み方</a>
        <a href={`${base}disclaimer/`}>免責事項</a>
        <a href={`${base}privacy/`}>プライバシーポリシー</a>
        <a href={`${base}contact/`}>お問い合わせ</a>
      </nav>
      <p class="footer-operator">運営者：<a href={`${base}about/`}>AI日本の裏側</a></p>
      <p>学習・情報提供を目的としたサイトです。投資助言ではありません。</p>
    </footer>
    <nav class="tab-nav">
      <a href={base} class={currentTab === "today" ? "active" : ""}>今日</a>
      <a href={`${base}market/`} class={currentTab === "market" ? "active" : ""}>マーケット</a>
      <a href={`${base}guides/`} class={currentTab === "guides" ? "active" : ""}>記事</a>
      <a href={`${base}teachings/`} class={currentTab === "teachings" ? "active" : ""}>教え</a>
    </nav>
  </body>
</html>
