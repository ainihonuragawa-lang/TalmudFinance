---
interface Props {
  label?: string;
}

const { label = "広告スペース" } = Astro.props;
---

<aside class="ad-placeholder" aria-label={label}>
  <div class="ad-label">{label}</div>
  <p>審査通過後に、本文を邪魔しない控えめな広告枠として使用します。</p>
</aside>

<style>
  .ad-placeholder {
    border: 1px dashed color-mix(in srgb, var(--accent) 48%, transparent);
    border-radius: 8px;
    color: var(--text-muted);
    margin: 20px 0 12px;
    padding: 14px;
    text-align: center;
  }

  .ad-label {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
    margin-bottom: 4px;
  }

  p {
    font-size: 0.82rem;
    margin: 0;
  }
</style>
