---
import Layout from "@/layouts/Layout.astro";
import TeachingCard from "@/components/TeachingCard.astro";
import QuoteRow from "@/components/QuoteRow.astro";
import MarketInsightCard from "@/components/MarketInsightCard.astro";
import { loadTeachings, getTodaysTeaching } from "@/lib/teachings";
import { buildMarketInsight, fetchAll } from "@/lib/market";

const collection = await loadTeachings();
const teaching = getTodaysTeaching(collection.teachings);

const allQuotes = await fetchAll();
const insight = buildMarketInsight(allQuotes);
const summarySymbols = [
  "^N225",
  "1306.T",
  "^GSPC",
  "^IXIC",
  "JPY=X",
  "^TNX",
  "^VIX",
  "GC=F",
  "CL=F",
  "BTC-USD",
];
const summary = summarySymbols
  .map((s) => allQuotes.find((q) => q.symbol === s))
  .filter((q): q is NonNullable<typeof q> => q !== undefined);
---

<Layout title="賢者の金融市場 - タルムードに学ぶ" currentTab="today">
  <header class="brand-header">
    <p class="brand-kicker">タルムードに学ぶ</p>
    <h1>賢者の金融市場</h1>
    <p class="brand-subtitle">古代の知恵と今日の市場データを、毎朝1画面で。</p>
  </header>

  <TeachingCard teaching={teaching} featured showDate />

  <MarketInsightCard insight={insight} />

  <h2>主要指標サマリー</h2>
  <div class="card">
    {summary.length === 0 ? (
      <p class="muted">市場データを取得できませんでした。</p>
    ) : (
      summary.map((q) => <QuoteRow quote={q} />)
    )}
  </div>
</Layout>

<style>
  .brand-header {
    margin-bottom: 18px;
  }

  .brand-kicker {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0 0 2px;
  }

  .brand-header h1 {
    font-size: 2rem;
    letter-spacing: 0;
    margin-bottom: 4px;
  }

  .brand-subtitle {
    color: var(--text);
    margin: 0;
  }
</style>
