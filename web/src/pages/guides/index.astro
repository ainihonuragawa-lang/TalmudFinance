---
import Layout from "@/layouts/Layout.astro";
import { guides, guideCategories } from "@/data/guides";

// カテゴリごとに記事をグルーピング（未分類はその他へ）
const grouped = guideCategories
  .map((category) => ({
    category,
    items: guides.filter((g) => g.category === category),
  }))
  .filter((group) => group.items.length > 0);
---

<Layout
  title="市場の読み方 - 投資の基礎とタルムードの知恵 | 賢者の金融市場"
  description="日経平均・VIX・イールドカーブ・ドル円の読み方から、分散・複利・ドルコスト平均法・リスク管理、タルムード的な市場観まで。相場を落ち着いて学ぶ解説記事の一覧です。"
  currentTab="guides"
>
  <article class="policy-page">
    <p class="brand-kicker">市場を読むための学び</p>
    <h1>市場の読み方</h1>
    <p>
      日々の市場データを、短期的な売買判断ではなく、観察と学習の材料として読むための記事です。
      株価、為替、金利、リスク指標を組み合わせて見ることで、数字の背後にある市場心理を落ち着いて考えます。
      指数や為替の仕組みといった基礎から、分散・複利・リスク管理などの投資の考え方、
      そしてタルムードの知恵を投資に応用する視点まで、全{guides.length}本の記事を用意しています。
    </p>

    {grouped.map((group) => (
      <section class="guide-section">
        <h2 class="guide-section-title">{group.category}</h2>
        <div class="guide-grid">
          {group.items.map((guide) => (
            <a class="guide-card" href={`/guides/${guide.slug}/`}>
              <span>{guide.readingTime}・公開 {guide.published}・最終更新 {guide.updated}</span>
              <h3>{guide.title}</h3>
              <p>{guide.description}</p>
            </a>
          ))}
        </div>
      </section>
    ))}
  </article>
</Layout>

<style>
  .guide-section {
    margin-top: 28px;
  }

  .guide-section-title {
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    font-size: 1.15rem;
    margin-bottom: 14px;
    padding-bottom: 6px;
  }
</style>
