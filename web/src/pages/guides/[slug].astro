---
import Layout from "@/layouts/Layout.astro";
import { guideArticles, type GuideArticle } from "@/data/guides";

export function getStaticPaths() {
  return guideArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: GuideArticle };

// 関連記事: 同カテゴリを優先し、足りなければ他カテゴリで補完して最大3件
const sameCategory = guideArticles.filter(
  (a) => a.slug !== article.slug && a.category === article.category,
);
const others = guideArticles.filter(
  (a) => a.slug !== article.slug && a.category !== article.category,
);
const related = [...sameCategory, ...others].slice(0, 3);

// 記事冒頭のリード（未設定なら description を代用）
const lead = article.lead ?? article.description;

// サイトのルートURL と このページの絶対URL
const siteRoot = (Astro.site ?? new URL("https://talmudfinance.com/")).href;
const pageUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const guidesUrl = new URL("guides/", siteRoot).href;

// 「2026年7月24日」→「2026-07-24」（構造化データの日付用）
function toISODate(jp: string): string | undefined {
  const m = /(\d+)年(\d+)月(\d+)日/.exec(jp);
  if (!m) return undefined;
  const [, y, mo, d] = m;
  return `${y}-${mo.padStart(2, "0")}-${d.padStart(2, "0")}`;
}

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.description,
  datePublished: toISODate(article.published),
  dateModified: toISODate(article.updated),
  author: { "@type": "Person", name: "AI日本の裏側" },
  publisher: {
    "@type": "Organization",
    name: "賢者の金融市場",
    url: siteRoot,
  },
  mainEntityOfPage: pageUrl,
  inLanguage: "ja",
};

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "ホーム", item: siteRoot },
    { "@type": "ListItem", position: 2, name: "市場の読み方", item: guidesUrl },
    { "@type": "ListItem", position: 3, name: article.title, item: pageUrl },
  ],
};
---

<Layout
  title={`${article.title} - 賢者の金融市場`}
  description={article.description}
  currentTab="guides"
>
  <nav class="breadcrumb" aria-label="パンくずリスト">
    <a href="/">ホーム</a>
    <span class="sep" aria-hidden="true">›</span>
    <a href="/guides/">市場の読み方</a>
    <span class="sep" aria-hidden="true">›</span>
    <span aria-current="page">{article.title}</span>
  </nav>

  <article class="policy-page guide-article">
    <p class="brand-kicker">市場を読むための学び・{article.category}</p>
    <h1>{article.title}</h1>
    <p class="muted article-meta">
      読了目安 {article.readingTime}　/　公開 {article.published}　/　最終更新 {article.updated}　/　文・編集: <a href="/about/">AI日本の裏側</a>
    </p>
    <p class="article-lead">{lead}</p>

    <nav class="toc" aria-label="目次">
      <p class="toc-title">目次</p>
      <ol>
        {article.sections.map((section, i) => (
          <li><a href={`#sec-${i}`}>{section.heading}</a></li>
        ))}
      </ol>
    </nav>

    {article.sections.map((section, i) => (
      <section class="article-section" id={`sec-${i}`}>
        <h2>{section.heading}</h2>
        {section.blocks
          ? section.blocks.map((block) =>
              block.type === "p" ? (
                <p>{block.text}</p>
              ) : block.type === "table" ? (
                <figure class="data-figure">
                  <div class="table-scroll">
                    <table>
                      <thead>
                        <tr>{block.headers.map((h) => <th>{h}</th>)}</tr>
                      </thead>
                      <tbody>
                        {block.rows.map((row) => (
                          <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                  {block.caption && <figcaption>{block.caption}</figcaption>}
                </figure>
              ) : block.type === "svg" ? (
                <figure class="data-figure">
                  <div class="svg-wrap" set:html={block.svg} />
                  {block.caption && <figcaption>{block.caption}</figcaption>}
                </figure>
              ) : block.type === "faq" ? (
                <div class="faq">
                  {block.items.map((item) => (
                    <details class="faq-item">
                      <summary>{item.q}</summary>
                      <p>{item.a}</p>
                    </details>
                  ))}
                </div>
              ) : block.type === "refs" ? (
                <ul class="refs-list">
                  {block.items.map((ref) => (
                    <li>
                      <a href={ref.url} target="_blank" rel="noopener noreferrer">{ref.label}</a>
                      {ref.note && <span class="muted"> — {ref.note}</span>}
                    </li>
                  ))}
                </ul>
              ) : block.type === "links" ? (
                <nav class="inline-links" aria-label={block.title ?? "関連ページ"}>
                  {block.title && <p class="inline-links-title">{block.title}</p>}
                  <ul>
                    {block.items.map((link) => (
                      <li>
                        <a href={link.href}>{link.label}</a>
                        {link.note && <span class="muted"> — {link.note}</span>}
                      </li>
                    ))}
                  </ul>
                </nav>
              ) : null,
            )
          : (section.body ?? []).map((paragraph) => <p>{paragraph}</p>)}
      </section>
    ))}

    <aside class="article-note">
      <h2>このページの位置づけ</h2>
      <p>
        本記事は市場を観察するための一般的な学習コンテンツです。特定の金融商品の売買、
        保有、解約を勧めるものではありません。実際の判断は、ご自身の目的、資産状況、
        リスク許容度を確認したうえで行ってください。
      </p>
    </aside>

    <section class="related">
      <h2>あわせて読みたい</h2>
      <ul>
        {related.map((r) => (
          <li>
            <a href={`/guides/${r.slug}/`}>{r.title}</a>
            <span class="muted">（{r.readingTime}）</span>
          </li>
        ))}
      </ul>
    </section>

    <p class="back-link"><a href="/guides/">市場の読み方一覧へ戻る</a></p>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Layout>

<style>
  .breadcrumb {
    font-size: 0.82rem;
    margin: 0 0 12px;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .breadcrumb .sep {
    margin: 0 6px;
    color: var(--text-muted);
  }

  .article-meta {
    margin-top: 0;
  }

  .article-lead {
    font-size: 1.02rem;
    line-height: 1.9;
  }

  /* 目次 */
  .toc {
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-elevated));
    border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent);
    border-radius: 10px;
    padding: 14px 16px;
    margin: 20px 0 8px;
  }

  .toc-title {
    color: var(--accent);
    font-weight: 700;
    font-size: 0.92rem;
    margin: 0 0 8px;
  }

  .toc ol {
    margin: 0;
    padding-left: 1.3rem;
  }

  .toc li {
    margin-bottom: 5px;
    line-height: 1.6;
  }

  .toc a {
    color: var(--text);
    text-decoration: none;
  }

  .toc a:hover {
    text-decoration: underline;
    color: var(--accent);
  }

  /* 図表 */
  .data-figure {
    margin: 20px 0;
  }

  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .data-figure table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.9rem;
    min-width: 320px;
  }

  .data-figure th,
  .data-figure td {
    border: 1px solid color-mix(in srgb, var(--ink-light) 50%, transparent);
    padding: 8px 10px;
    text-align: left;
    line-height: 1.6;
    vertical-align: top;
  }

  .data-figure thead th {
    background: color-mix(in srgb, var(--accent) 16%, var(--bg-elevated));
    color: var(--text);
    font-weight: 700;
  }

  .data-figure tbody tr:nth-child(even) {
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }

  .data-figure .svg-wrap {
    background: color-mix(in srgb, var(--accent) 5%, var(--bg-elevated));
    border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
    border-radius: 10px;
    padding: 12px;
  }

  .data-figure :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .data-figure figcaption {
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.7;
    margin-top: 8px;
  }

  /* FAQ */
  .faq {
    margin: 16px 0 4px;
  }

  .faq-item {
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: 8px;
    margin-bottom: 10px;
    padding: 0 14px;
    background: var(--bg-elevated);
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 700;
    padding: 12px 0;
    color: var(--text);
    line-height: 1.6;
  }

  .faq-item summary:hover {
    color: var(--accent);
  }

  .faq-item[open] summary {
    color: var(--accent);
  }

  .faq-item p {
    margin: 0 0 14px;
    line-height: 1.85;
  }

  /* 参考情報 */
  .refs-list {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
  }

  .refs-list li {
    border-left: 3px solid color-mix(in srgb, var(--accent) 55%, transparent);
    margin-bottom: 8px;
    padding-left: 12px;
    line-height: 1.7;
  }

  .refs-list a {
    font-weight: 600;
  }

  /* サイト内リンク（教えの個別ページなど） */
  .inline-links {
    background: color-mix(in srgb, var(--accent) 7%, var(--bg-elevated));
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: 10px;
    margin: 18px 0;
    padding: 14px 16px;
  }

  .inline-links-title {
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .inline-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .inline-links li {
    line-height: 1.75;
    margin-bottom: 6px;
  }

  .inline-links a {
    font-weight: 600;
  }

  .related {
    border-top: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    margin-top: 28px;
    padding-top: 16px;
  }

  .related h2 {
    font-size: 1.1rem;
    margin-bottom: 10px;
  }

  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related li {
    margin-bottom: 8px;
  }
</style>
