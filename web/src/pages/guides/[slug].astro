---
import Layout from "@/layouts/Layout.astro";
import { guideArticles, type GuideArticle } from "@/data/guides";

export function getStaticPaths() {
  return guideArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: GuideArticle };

// 関連記事: 同カテゴリを優先し、足りなければ他カテゴリで補完して最大3件
const sameCategory = guideArticles.filter(
  (a) => a.slug !== article.slug && a.category === article.category,
);
const others = guideArticles.filter(
  (a) => a.slug !== article.slug && a.category !== article.category,
);
const related = [...sameCategory, ...others].slice(0, 3);
---

<Layout title={`${article.title} - 賢者の金融市場`} description={article.description}>
  <article class="policy-page guide-article">
    <p class="brand-kicker">市場を読むための学び・{article.category}</p>
    <h1>{article.title}</h1>
    <p class="muted">読了目安 {article.readingTime}　/　最終更新 {article.updated}　/　文・編集: <a href="/about/">AI日本の裏側</a></p>
    <p>{article.description}</p>

    {article.sections.map((section) => (
      <section class="article-section">
        <h2>{section.heading}</h2>
        {section.body.map((paragraph) => <p>{paragraph}</p>)}
      </section>
    ))}

    <aside class="article-note">
      <h2>このページの位置づけ</h2>
      <p>
        本記事は市場を観察するための一般的な学習コンテンツです。特定の金融商品の売買、
        保有、解約を勧めるものではありません。実際の判断は、ご自身の目的、資産状況、
        リスク許容度を確認したうえで行ってください。
      </p>
    </aside>

    <section class="related">
      <h2>あわせて読みたい</h2>
      <ul>
        {related.map((r) => (
          <li>
            <a href={`/guides/${r.slug}/`}>{r.title}</a>
            <span class="muted">（{r.readingTime}）</span>
          </li>
        ))}
      </ul>
    </section>

    <p class="back-link"><a href="/guides/">市場の読み方一覧へ戻る</a></p>
  </article>
</Layout>

<style>
  .related {
    border-top: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    margin-top: 28px;
    padding-top: 16px;
  }

  .related h2 {
    font-size: 1.1rem;
    margin-bottom: 10px;
  }

  .related ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related li {
    margin-bottom: 8px;
  }
</style>
