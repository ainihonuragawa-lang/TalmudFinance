---
import Layout from "@/layouts/Layout.astro";
import QuoteRow from "@/components/QuoteRow.astro";
import MarketInsightCard from "@/components/MarketInsightCard.astro";
import { buildMarketInsight, fetchAll, getDataFreshness, type MarketCategory } from "@/lib/market";
import { guides } from "@/data/guides";

// 関連記事リンク用の slug → タイトル対応表
const guideTitle = new Map(guides.map((g) => [g.slug, g.title]));

const allQuotes = await fetchAll();
const insight = buildMarketInsight(allQuotes);
const freshness = getDataFreshness(allQuotes);
const staleDateLabel = freshness.oldestAsOf
  ? new Date(freshness.oldestAsOf).toLocaleString("ja-JP", {
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      timeZone: "Asia/Tokyo",
    })
  : null;

const categories: {
  key: MarketCategory;
  label: string;
  emoji: string;
  guidance: string;
  related: string[];
}[] = [
  {
    key: "JP_STOCK",
    label: "日本株",
    emoji: "🗾",
    guidance:
      "日本株は国内の材料だけでなく、前日の米国市場やドル円の動きを強く受ける日があります。代表指数の日経平均とTOPIXは算出方法が異なり、同じ日でも動きがずれることがあります。指数の大きな動きが一部の値がさ株によるものか、幅広い銘柄によるものかを意識すると、相場の質が見えやすくなります。",
    related: ["what-is-nikkei"],
  },
  {
    key: "US_STOCK",
    label: "米国株",
    emoji: "🗽",
    guidance:
      "米国株は世界のリスク資産の基準になりやすく、日本株の翌日の地合いにも影響します。長い上昇・下落の波（サイクル）のなかでは、価格だけでなく参加者の心理も揺れます。転換点を当てにいくより、サイクルに耐えられる範囲のリスクで長く付き合う視点が役立ちます。",
    related: ["market-cycles"],
  },
  {
    key: "ETF",
    label: "ETF",
    emoji: "◇",
    guidance:
      "ETFは、1本で多くの銘柄や複数の国・資産に投資できる分散の道具です。ただし中身が似た商品を何本も重ねても、分散は深まりません。本数よりも、値動きの異なるものを組み合わせられているかどうかを優先して確認しましょう。",
    related: ["diversification"],
  },
  {
    key: "FX",
    label: "為替",
    emoji: "💴",
    guidance:
      "為替は二つの通貨の綱引きで決まり、円安・円高は立場によって意味が反転します。ドル円は日米の金利差やリスク回避の動きに影響されやすく、金利と一緒に見ると背景が立体的に見えてきます。「今日はどの力で動いているのか」を問う癖をつけると、ニュースの読み方が変わります。",
    related: ["dollar-yen", "interest-rate-fx"],
  },
  {
    key: "CRYPTO",
    label: "暗号資産",
    emoji: "₿",
    guidance:
      "暗号資産は値動きが大きく、リスク資産全体の雰囲気を映すことがあります。だからこそ、自分がどれだけの変動まで冷静でいられるか（リスク許容度）を、買う前に金額で言葉にしておくことが大切です。全体のなかでの位置づけを意識して眺めましょう。",
    related: ["risk-tolerance"],
  },
  {
    key: "COMMODITY_MACRO",
    label: "商品・マクロ",
    emoji: "◆",
    guidance:
      "原油や金などの商品、そしてVIXや金利といったマクロ指標は、相場の背景にある「気圧」のような存在です。VIXは市場の警戒感、金利は資産価格にかかる重力、利回り曲線は景気のメッセージを映します。単独で見るより、株価と重ねて文脈を読むのが実用的です。",
    related: ["vix-fear-index", "yield-curve"],
  },
];

const grouped = categories.map((c) => ({
  ...c,
  quotes: allQuotes.filter((q) => q.category === c.key),
}));

const now = new Date();
const lastUpdated = now.toLocaleString("ja-JP", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  timeZone: "Asia/Tokyo",
});
---

<Layout
  title="マーケット - 賢者の金融市場"
  description="日本株・米国株・ETF・為替・暗号資産・商品・金利の主要指標を一覧。取得失敗時は前回値で補完し、約30分ごとに自動更新します。"
  currentTab="market"
>
  <header>
    <h1>マーケット</h1>
    <p class="muted">ページ生成: {lastUpdated} (JST)・約30分ごとに自動更新</p>
    {freshness.hasStale && (
      <p class="stale-note">
        ⚠ 一部の銘柄は今回データを取得できなかったため、前回取得値（{staleDateLabel} 時点）を「前回値」として表示しています。
      </p>
    )}
  </header>

  <p class="page-usage">
    このページは、日本株・米国株・ETF・為替・暗号資産・商品やマクロ指標を一画面で見渡すためのものです。
    数字は売買のサインではなく、相場の背景を読むための材料として並べています。各カテゴリの「見方」と
    関連記事を手がかりに、上から順に眺めて、いつもと違う変化に気づくことを目的にしてください。
  </p>

  <nav class="anchor-nav" aria-label="マーケットカテゴリ">
    {categories.map((c) => (
      <a href={`#${c.key.toLowerCase()}`}>{c.label}</a>
    ))}
  </nav>

  <MarketInsightCard insight={insight} />

  {grouped.map((g) => (
    <section id={g.key.toLowerCase()}>
      <h2>{g.emoji} {g.label}</h2>
      <p class="cat-guidance">{g.guidance}</p>
      {g.related.length > 0 && (
        <p class="cat-related">
          <span class="cat-related-label">関連記事</span>
          {g.related.map((slug, idx) => (
            <>
              {idx > 0 && <span class="sep" aria-hidden="true">／</span>}
              <a href={`/guides/${slug}/`}>{guideTitle.get(slug) ?? slug}</a>
            </>
          ))}
        </p>
      )}
      <div class="card">
        {g.quotes.length === 0 ? (
          <p class="muted">このカテゴリのデータを取得できませんでした。</p>
        ) : (
          g.quotes.map((q) => <QuoteRow quote={q} />)
        )}
      </div>
    </section>
  ))}
</Layout>

<style>
  header {
    margin-bottom: 16px;
  }
  .page-usage {
    background: color-mix(in srgb, var(--accent) 8%, var(--bg-elevated));
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: 10px;
    font-size: 0.9rem;
    line-height: 1.85;
    margin: 0 0 16px;
    padding: 14px 16px;
  }
  .cat-guidance {
    font-size: 0.92rem;
    line-height: 1.8;
    margin: 0 0 8px;
  }
  .cat-related {
    font-size: 0.86rem;
    line-height: 1.7;
    margin: 0 0 10px;
  }
  .cat-related-label {
    background: color-mix(in srgb, var(--accent) 18%, var(--bg-elevated));
    border-radius: 6px;
    color: var(--text-muted);
    font-weight: 700;
    margin-right: 8px;
    padding: 2px 8px;
  }
  .cat-related .sep {
    color: var(--text-muted);
    margin: 0 6px;
  }
  .stale-note {
    background: color-mix(in srgb, var(--accent) 12%, var(--bg-elevated));
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 8px;
    color: var(--text);
    font-size: 0.82rem;
    margin: 10px 0 0;
    padding: 8px 12px;
  }
  section {
    margin-bottom: 24px;
    scroll-margin-top: 16px;
  }
  section h2 {
    font-size: 1.15rem;
    margin-bottom: 8px;
  }
  .anchor-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 16px;
  }

  .anchor-nav a {
    background: color-mix(in srgb, var(--accent) 18%, var(--bg-elevated));
    border: 1px solid color-mix(in srgb, var(--accent) 62%, transparent);
    border-radius: 8px;
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 600;
    padding: 10px 12px;
    text-align: center;
  }

  .anchor-nav a:hover {
    background: var(--accent);
    color: var(--bg);
    text-decoration: none;
  }

  @media (min-width: 560px) {
    .anchor-nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
